# Supabase (shared with TypeHype backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM provider — OpenRouter (used by all agents via LiteLLM)
OPENROUTER_API_KEY=sk-or-v1-...

# Postiz cloud API
POSTIZ_API_KEY=pos_...
POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# Hype Crew runtime config
HYPE_DRY_RUN=true              # Default ON for safety. Set false only after dry-run validation.
HYPE_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
HYPE_DAILY_COST_CAP_USD=2.00   # Hard stop if daily LLM cost exceeds this
HYPE_DEFAULT_SCHEDULE_DELAY_HOURS=2  # Schedule posts +N hours from now

# Model selection (override defaults if needed)
HYPE_MODEL_FAST=openrouter/openai/gpt-4o-mini    # TrendScout, Compliance, Publisher
HYPE_MODEL_SMART=openrouter/openai/gpt-4o        # Planner, Writer

# Memory backend
HYPE_MEMORY_BACKEND=supabase   # supabase | lancedb (default crewai)
