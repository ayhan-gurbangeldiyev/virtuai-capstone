# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AI / LLM
# OpenAI: direkt OpenAI API (magic_morning, legacy /generate/* endpoint'leri)
OPENAI_API_KEY=sk-proj-...
# OpenRouter: V2 /v2/generate/* endpoint'leri (TrendDashboard reply/quote)
OPENROUTER_API_KEY=sk-or-v1-...
# Model override (boş bırakılırsa default: gpt-4o). Örn: gpt-4o-mini
MODEL_CONTENT=gpt-4o
MODEL_VISION=gpt-4o
MODEL_ANALYSIS=gpt-4o-mini

# Security
COOKIE_ENCRYPTION_KEY=generate-with-fernet-generate-key
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CRON_SECRET=your-cron-secret
ALLOWED_EMAILS=you@example.com
ADMIN_EMAILS=you@example.com
# MCP server bearer token (TYPEHYPE_MCP_KEY alias da kabul edilir)
MCP_API_KEY=your-mcp-api-key

# External APIs
YOUTUBE_API_KEY=your-youtube-api-key
XQUIK_API_KEY=your-xquik-api-key

# Twitter/X Cookies (Bird CLI / GraphQL fallback için)
AUTH_TOKEN=your-twitter-auth-token
CT0=your-twitter-ct0-cookie
