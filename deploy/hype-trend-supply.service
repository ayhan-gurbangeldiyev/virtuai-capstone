[Unit]
Description=Hype Trend Supply Health Check — daily 24h AI supply audit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/contentfactory/backend
EnvironmentFile=/opt/contentfactory/backend/.env
ExecStart=/opt/contentfactory/backend/venv/bin/python /opt/contentfactory/backend/scripts/run_supply_health_check.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
