[Unit]
Description=Hype Crew Engagement Metrics Poller (Phase 22)
After=network-online.target contentfactory.service hype-crew.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hype-crew
EnvironmentFile=/opt/hype-crew/.env
ExecStart=/opt/hype-crew/venv/bin/python -m scripts.poll_engagement
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
